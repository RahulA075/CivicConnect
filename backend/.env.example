# ── Application ────────────────────────────────────────────────────
APP_PROFILE=dev
SERVER_PORT=8080

# ── Database ────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/civicconnect
DB_USERNAME=civicconnect_app
DB_PASSWORD=changeme
DB_POOL_MAX=20
DB_POOL_MIN=5

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── JWT (CHANGE IN PRODUCTION — minimum 64 chars) ────────────────────
JWT_SECRET=ThisIsAVeryLongSecretKeyForCivicConnectJwtTokenGenerationThatIsAtLeast64Chars!!
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=2592000000

# ── Mail ────────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Storage (S3-compatible) ──────────────────────────────────────────
STORAGE_BUCKET=civicconnect-media-dev
STORAGE_REGION=ap-south-1
CDN_BASE_URL=http://localhost:9000/civicconnect-media-dev

# ── CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ── Observability ────────────────────────────────────────────────────
TRACING_SAMPLE_RATE=0.1

# ── AI Analysis (Phase 11) ───────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
# Also compatible with Azure OpenAI, Google Gemini via OpenAI-compat layer, or local Ollama
AI_API_KEY=sk-your-openai-key-here
AI_TEXT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_AUTO_APPLY_THRESHOLD=0.85
AI_DUPLICATE_MAX_CANDIDATES=50
AI_ENABLED=true

# ── Firebase / FCM (Phase 10) ────────────────────────────────────────
# Download your service account JSON from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
# Set the path to that file here (absolute or relative to the backend working dir)
FCM_CREDENTIALS_PATH=/path/to/your/firebase-service-account.json
# Or place the file at: backend/src/main/resources/firebase-service-account.json
# (it will be picked up from the classpath automatically)
